# enable the custom databricks wrapper to avoid duplicate posts.
# Meta is best-effort because Meta Careers may block simple HTTP clients.
CUSTOM_SCRAPERS=amazon,microsoft,google,netflix
CUSTOM_SCRAPER_INTERVAL_MINUTES=30
