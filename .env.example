# Discord bot
DISCORD_TOKEN=your-bot-token-here
DISCORD_CHANNEL_ID=123456789012345678

# Greenhouse company slugs (comma-separated)
GREENHOUSE_SLUGS=stripe,anthropic,airbnb,cloudflare,figma,datadog,coinbase

# Lever company slugs (comma-separated)
LEVER_SLUGS=netflix,plaid

# Ashby company slugs (comma-separated)
ASHBY_SLUGS=rippling,ramp,notion

# Polling intervals (minutes)
POLL_INTERVAL_MINUTES=10
SIMPLIFY_POLL_INTERVAL_MINUTES=30

# Database
DB_PATH=jobs.db

# Optional: Meta scraper (aggressive rate limiting, use with caution)
# META_ENABLED=false
# META_POLL_INTERVAL_MINUTES=30
